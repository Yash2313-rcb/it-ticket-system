# Supabase project (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Never expose to the browser. Used to create users from the User Management page.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shown in the UI and later on reports
NEXT_PUBLIC_APP_NAME="IT Operations Platform"

# Public address of the deployed app (used inside asset QR codes), no trailing slash
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Optional: protects the daily alerts job at /api/cron/alerts
CRON_SECRET=generate-a-long-random-string
